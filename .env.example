# =====================================================================
# AI-NIDS Environment Configuration
# Chinhoyi University of Technology (CUT) - Group 5
# =====================================================================

# Flask API Port & Security
PORT=5000
FLASK_ENV=production
SECRET_KEY=cut-group5-ai-nids-production-secret-key-2026
JWT_SECRET_KEY=cut-jwt-cybersecurity-secret-key-2026
JWT_EXPIRES_HOURS=8

# Database Connection (Default: PostgreSQL, configurable for MySQL or SQLite)
# PostgreSQL format: postgresql://postgres:postgres@localhost:5432/ai_nids
# MySQL format: mysql+pymysql://root:password@localhost:3306/ai_nids
# SQLite format (default fallback): sqlite:///ai_nids.db
DATABASE_URL=sqlite:///ai_nids.db

# Wireshark / TShark Binary Path
# Windows default: C:\Program Files\Wireshark\tshark.exe
# Linux default: /usr/bin/tshark
TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# Initial Administrator Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CUT_Nids_Admin2026!

# Remote Distributed Sensor API Ingestion Key
SENSOR_API_KEY=cut-sensor-agent-key-secret-2026

# Automated Mitigation (Safe Default: false, records recommended blocks only)
ENABLE_ACTIVE_BLOCKING=false

# Upload Limits
MAX_UPLOAD_SIZE_MB=100
